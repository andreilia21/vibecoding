    {
      "parameters": {
        "jsCode": "const issue = $json.issue ?? $json;\nconst fields = issue.fields ?? {};\nconst labels = Array.isArray(fields.labels) ? fields.labels.map(String) : [];\nconst normalizedLabels = labels.map((label) => label.toLowerCase());\nconst assignee = String(fields.assignee?.displayName ?? fields.assignee?.name ?? fields.assignee?.accountId ?? '').toLowerCase();\nconst status = String(fields.status?.name ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');\n\nconst selectedWorker = normalizedLabels.includes('codex-worker') || assignee === 'codex-worker';\nconst isInProgress = status === 'inprogress';\nconst alreadyHandled = normalizedLabels.some((label) => ['codex-processing', 'codex-done'].includes(label));\n\nif (!selectedWorker || !isInProgress || alreadyHandled) {\n  return [];\n}\n\nconst description = typeof fields.description === 'string'\n  ? fields.description\n  : JSON.stringify(fields.description ?? '');\nconst jiraUrl = String(issue.self ?? '').replace(/\\/rest\\/api\\/[^/]+\\/issue\\/.+$/, `/browse/${issue.key}`);\nconst baseLabels = labels.filter((label) => !['codex-ready', 'codex-processing', 'codex-done', 'codex-failed'].includes(label.toLowerCase()));\n\nreturn [{\n  json: {\n    jiraKey: issue.key,\n    summary: String(fields.summary ?? ''),\n    description,\n    jiraUrl,\n    baseLabels,\n    processingLabels: [...baseLabels, 'codex-processing'],\n    doneLabels: [...baseLabels, 'codex-done'],\n    failedLabels: [...baseLabels, 'codex-failed']\n  }\n}];"
      },
