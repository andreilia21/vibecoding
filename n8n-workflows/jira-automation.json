    {
      "parameters": {
        "jsCode": "const transitions = $input.all();\nconst normalize = (value) => String(value ?? '').trim().toLowerCase().replace(/[^a-z0-9а-яё]/g, '');\nconst aliases = String($env.JIRA_TODO_NAMES ?? 'To Do,К выполнению').split(',').map(normalize).filter(Boolean);\nconst target = transitions.find((item) => item.json.to?.statusCategory?.key === 'new')\n  ?? transitions.find((item) => aliases.includes(normalize(item.json.name)) || aliases.includes(normalize(item.json.to?.name)));\nif (!target) {\n  const available = transitions.map((item) => `${item.json.id}: ${item.json.name ?? 'unnamed'} -> ${item.json.to?.name ?? 'unknown'} [category ${item.json.to?.statusCategory?.key ?? 'unknown'}]`).join(', ');\n  throw new Error(`Jira To Do transition is not available. Configured aliases: ${aliases.join(', ') || 'none'}. Available transitions: ${available || 'none'}`);\n}\nreturn [{ json: { transitionId: String(target.json.id) } }];"
      },
