    {
      "parameters": {
        "jsCode": "const transitions = $input.all();\nconst normalize = (value) => String(value ?? '').trim().toLowerCase().replace(/[^a-z0-9а-яё]/g, '');\nconst aliases = String($env.JIRA_IN_REVIEW_NAMES ?? 'In Review,To Review,Review,Code Review,Ready for Review,В процессе проверки,На проверке').split(',').map(normalize).filter(Boolean);\nconst target = transitions.find((item) => aliases.includes(normalize(item.json.name)) || aliases.includes(normalize(item.json.to?.name)));\nif (!target) {\n  const available = transitions.map((item) => `${item.json.id}: ${item.json.name ?? 'unnamed'} -> ${item.json.to?.name ?? 'unknown'} [category ${item.json.to?.statusCategory?.key ?? 'unknown'}]`).join(', ');\n  throw new Error(`Jira review transition is not available. Configured aliases: ${aliases.join(', ') || 'none'}. Available transitions: ${available || 'none'}`);\n}\nreturn [{ json: { transitionId: String(target.json.id) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
