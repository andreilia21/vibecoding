        "resource": "issue",
        "operation": "update",
        "issueKey": "={{ $('Validate Review Command').item.json.jiraKey }}",
        "updateFields": { "statusId": { "__rl": true, "value": "={{ $json.transitionId }}", "mode": "id" } },
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [960, 0],
      "id": "987ef0c9-8a95-4fa4-a110-889cd447269f",
      "name": "Move to In Progress",
      "credentials": { "jiraSoftwareCloudOAuth2Api": { "id": "KnO2tRxIhCMr6mXx", "name": "Jira SW Cloud account" } }
    },
