      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "65194079-09b6-4d6e-ae87-93b21f971d48",
      "name": "GitHub Trigger"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body ?? $json;\nconst command = String(payload.comment?.body ?? '').trim();\nconst association = String(payload.comment?.author_association ?? '').toUpperCase();\nconst allowed = ['OWNER', 'MEMBER', 'COLLABORATOR'];\n\nif (payload.action !== 'created' || !payload.issue?.pull_request || !/^\\/codex\\s+fix$/i.test(command) || !allowed.includes(association)) {\n  return [];\n}\n\nconst source = [payload.issue.body, payload.issue.title].filter(Boolean).join('\\n');\nconst marker = source.match(/codex-jira-key:\\s*([A-Z][A-Z0-9]+-\\d+)/i);\nconst fallback = source.match(/\\b([A-Z][A-Z0-9]+-\\d+)\\b/i);\nconst jiraKey = (marker?.[1] ?? fallback?.[1] ?? '').toUpperCase();\nif (!jiraKey) {\n  throw new Error('Pull request is not linked to Jira. Add <!-- codex-jira-key: PROJECT-123 --> to the PR body.');\n}\n\nreturn [{ json: {\n  jiraKey,\n  prNumber: Number(payload.issue.number),\n  prUrl: payload.issue.html_url,\n  reviewCommandId: String(payload.comment.id),\n  requestedBy: String(payload.comment.user?.login ?? 'unknown')\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "id": "acdf8851-1bf6-4442-906d-a141f84f4c5b",
      "name": "Validate Review Command"
    },
    {
      "parameters": {
        "jiraVersion": "cloudOAuth2",
        "resource": "issue",
        "operation": "transitions",
        "issueKey": "={{ $('Validate Review Command').item.json.jiraKey }}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [480, 0],
      "id": "056a3bb3-573a-4569-afc7-3cbec10202ed",
      "name": "Get In Progress Transitions",
      "credentials": { "jiraSoftwareCloudOAuth2Api": { "id": "KnO2tRxIhCMr6mXx", "name": "Jira SW Cloud account" } }
    },
    {
      "parameters": {
        "jsCode": "const transitions = $input.all();\nconst normalize = (value) => String(value ?? '').trim().toLowerCase().replace(/[^a-z0-9а-яё]/g, '');\nconst aliases = String($env.JIRA_IN_PROGRESS_NAMES ?? 'In Progress,Start Progress,В работе').split(',').map(normalize).filter(Boolean);\nconst target = transitions.find((item) => aliases.includes(normalize(item.json.name)) || aliases.includes(normalize(item.json.to?.name)));\nif (!target) {\n  const available = transitions.map((item) => `${item.json.id}: ${item.json.name ?? 'unnamed'} -> ${item.json.to?.name ?? 'unknown'} [category ${item.json.to?.statusCategory?.key ?? 'unknown'}]`).join(', ');\n  throw new Error(`Jira In Progress transition is not available. Configured aliases: ${aliases.join(', ') || 'none'}. Available transitions: ${available || 'none'}`);\n}\nreturn [{ json: { transitionId: String(target.json.id) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "id": "a84d912c-5786-4bd4-a105-bc48a78e402d",
      "name": "Select In Progress Transition"
    },
